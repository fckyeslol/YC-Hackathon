{
  "name": "verdict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal financial advisor in iMessage whose advice is reviewed and improved by real, anonymized humans: chat via Linq, agent wallet + on-chain ledger via Dynamic, human judgment recruited via Terac and aggregated with Dawid-Skene. Spec-driven (see specs/).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "qa:report": "tsx qa/reporte-before-after.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dynamic-labs-wallet/core": "^1.0.80",
    "@dynamic-labs-wallet/node": "^1.0.80",
    "@dynamic-labs-wallet/node-evm": "^1.0.80",
    "@fastify/static": "^8.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "viem": "^2.54.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
