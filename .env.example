# Verdict — environment configuration.
#
# Copy to `.env` and fill in what you have. EVERY adapter is optional: without its
# key it degrades to a fail-closed stub, so the server and the full test suite run
# regardless. The schema in `src/config.ts` is the source of truth.
#
# Never commit the real `.env` (gitignored). Rotate anything that leaks.

# =============================================================================
# Linq — iMessage / RCS / SMS  (spec: linq-messaging)
# =============================================================================
# Get these from `linq whoami` after `linq signup`.
LINQ_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Your org's sending number, E.164.
LINQ_NUMBER=+1XXXXXXXXXX
# HMAC secret for webhook verification (BR-L1). ABSENT → /webhooks/linq rejects
# every event with 401 (fail closed). Use a PERSISTENT secret from
# `linq webhooks create` — the one `linq listen` prints is per-session.
LINQ_WEBHOOK_SECRET=

# =============================================================================
# Terac — real-human recruiting API (https://terac.com)
# =============================================================================
TERAC_API_KEY=tk_xxx

# =============================================================================
# Dynamic — agent wallet + on-chain ledger  (spec: dynamic-payments)
# =============================================================================
# Dashboard → Developer → API. Not a secret (it ships in client bundles).
DYNAMIC_ENVIRONMENT_ID=
# Only for the server-wallet route; the agent-wallet route does NOT need it.
DYNAMIC_API_TOKEN=
# 32-byte secp256k1 key that IS the agent's Dynamic user identity. Generate once:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"
# Rotating it creates a BRAND-NEW user with no access to the funded wallet.
DYNAMIC_AGENT_SIGNING_TOKEN=
# Protects the MPC key shares backed up to Dynamic. Strong and unique.
DYNAMIC_WALLET_PASSWORD=
# Origin presented during the agent's SIWE sign-in. Must be allow-listed under
# Dashboard → Security → Allowed CORS Origin (an EMPTY list allows every origin).
DYNAMIC_APP_ORIGIN=http://localhost:3000
# Public RPC by default on purpose: shared/rate-limited keys fail at demo time.
DYNAMIC_RPC_URL=https://sepolia.base.org
# USDC on Base Sepolia.
DYNAMIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Payee book (BR-D9): "mama:0xabc...,juan:0xdef...". A recipient outside this list
# is NEVER paid — that is the guardrail, not an inconvenience.
DYNAMIC_PAYEES=
# COP per 1 USDC (BR-D10). Configuration, NOT a market oracle.
DYNAMIC_COP_PER_USDC=4000
# Hard per-transaction ceiling in USDC (BR-D10).
DYNAMIC_MAX_USDC_PER_TX=5
# Where the wallet metadata is remembered. Losing this file makes the next boot
# create a NEW empty wallet and strand the funds on the old address.
DYNAMIC_WALLET_STORE_PATH=./data/dynamic-wallet.json

# =============================================================================
# Claude via Runware — intent parser + leak-check auditor  (ADR-006)
# =============================================================================
# Absent → parseIntent falls back to "unknown" and never guesses money (BR-P10).
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai/v1
# Haiku 4.5 is the cheap default for classification; bump for more capability.
RUNWARE_LLM_MODEL=anthropic-claude-haiku-4-5

# =============================================================================
# Groq / Whisper — voice notes  (spec: voice-transcription)
# =============================================================================
# Absent → the agent asks the user to type rather than guess at an audio (BR-V3).
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
STT_LANG=es

# =============================================================================
# Server
# =============================================================================
PORT=3000
# Public base URL, no trailing slash. Used for the Terac task_url and the Linq
# webhook target. Locally this is your tunnel; in prod, the deploy URL.
PUBLIC_URL=http://localhost:3000

# =============================================================================
# Runtime notes — read before deploying
# =============================================================================
# BR-D7: Dynamic's MPC signer is a native addon built ONLY for linux x64/arm64 and
# macOS. On Windows it throws `Neon: unsupported system: win32` AT IMPORT, and it
# does not run under Bun, Deno or edge runtimes. Deploy to a Node runtime on Linux;
# on Windows, develop through WSL.
#
# On WSL, DNS can resolve these hosts to IPv6-only records while IPv6 egress is
# broken, so every Node HTTP client hangs for minutes before timing out. If that
# happens, set:
#   NODE_OPTIONS=--dns-result-order=ipv4first
